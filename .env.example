# La configurazione principale vive in config/settings.toml.
# Questo file serve solo per override opzionali: le variabili d'ambiente hanno
# priorita' sul file TOML. Copia in .env e decommenta solo cio' che ti serve.
#
# Percorso del file di configurazione (default: config/settings.toml)
# SIAMO_CONFIG_FILE=config/settings.toml
#
# Esempio: eseguire tutto in locale, usando i servizi pubblicati su localhost
# invece dei nomi dei container.
# OLLAMA_BASE_URL=http://localhost:11434
# QDRANT_URL=http://localhost:6333
# GUI_API_URL=http://localhost:8000
#
# Esempio: cambiare modello senza toccare il file TOML
# LLM_MODEL=gemma3:1b
